@model List<Sicoob.Models.Log>

@{
    ViewData["Title"] = "Auditoria e Logs";
    Layout = "_Layout";
}

<h2 class="mt-4 mb-3">Auditoria e Logs</h2>

<table class="table table-striped table-sm">
    <thead>
    <tr>
        <th>Usuário</th>
        <th>Ação</th>
        <th>Descrição</th>
        <th>IP</th>
        <th>Data/Hora</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var log in Model)
    {
        <tr>
            <td>@log.Usuario?.NomeUsuario</td>
            <td>@log.Acao</td>
            <td>@log.Descricao</td>
            <td>@log.Ip</td>
            <td>@log.DataHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
        </tr>
    }
    </tbody>
</table>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum log registrado ainda.</div>
}

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= (int)ViewBag.TotalPaginas; i++)
        {
            <li class="page-item @(i == (int)ViewBag.PaginaAtual ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a>
            </li>
        }
    </ul>
</nav>